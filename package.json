{
  "name": "office-manager-ai",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": { "node": ">=20" },
  "scripts": {
    "test:lab": "node --test eynowa-lab/professional/*.test.js",
    "lab:eval": "node eynowa-lab/professional/run-evals.js",
    "lab:eval:live": "node eynowa-lab/professional/run-evals.js --live",
    "lab:import": "node eynowa-lab/professional/import-knowledge.js",
    "lab:import:ohada": "node eynowa-lab/professional/packs/ohada/import-ohada.js",
    "lab:import:ohada:starter": "node eynowa-lab/professional/packs/ohada/import-ohada.js eynowa-lab/professional/packs/ohada/public-starter-pack.json",
    "lab:import:ohada:immobilisations": "node eynowa-lab/professional/packs/ohada/import-ohada.js eynowa-lab/professional/packs/ohada/immobilisations-public-guidance.json",
    "lab:import:ohada:stocks": "node eynowa-lab/professional/import-knowledge.js eynowa-lab/professional/packs/ohada/stocks/starter-pack.json",
    "lab:import:ohada:purchases": "node eynowa-lab/professional/import-knowledge.js eynowa-lab/professional/packs/ohada/purchases/eynowa-methodology.json && node eynowa-lab/professional/import-knowledge.js eynowa-lab/professional/packs/ohada/purchases/audit-public-guidance.json",
    "lab:import:ohada:sales": "node eynowa-lab/professional/import-knowledge.js eynowa-lab/professional/packs/ohada/sales-receivables/eynowa-methodology.json && node eynowa-lab/professional/import-knowledge.js eynowa-lab/professional/packs/ohada/sales-receivables/audit-public-guidance.json",
    "lab:import:ohada:treasury": "node eynowa-lab/professional/import-knowledge.js eynowa-lab/professional/packs/ohada/treasury/eynowa-accounting-methodology.json && node eynowa-lab/professional/import-knowledge.js eynowa-lab/professional/packs/ohada/treasury/eynowa-audit-methodology.json && node eynowa-lab/professional/import-knowledge.js eynowa-lab/professional/packs/ohada/treasury/audit-public-guidance.json",
    "lab:import:ohada:provisions": "node eynowa-lab/professional/import-knowledge.js eynowa-lab/professional/packs/ohada/provisions/eynowa-accounting-methodology.json && node eynowa-lab/professional/import-knowledge.js eynowa-lab/professional/packs/ohada/provisions/eynowa-audit-methodology.json && node eynowa-lab/professional/import-knowledge.js eynowa-lab/professional/packs/ohada/provisions/audit-public-guidance.json",
    "lab:import:ohada:core-final": "node eynowa-lab/professional/import-knowledge.js eynowa-lab/professional/packs/ohada/core-final/eynowa-accounting-methodology.json && node eynowa-lab/professional/import-knowledge.js eynowa-lab/professional/packs/ohada/core-final/eynowa-audit-methodology.json && node eynowa-lab/professional/import-knowledge.js eynowa-lab/professional/packs/ohada/core-final/official-public-guidance.json",
    "lab:import:ohada:all": "npm run lab:import:ohada:starter && npm run lab:import:ohada:immobilisations && npm run lab:import:ohada:stocks && npm run lab:import:ohada:purchases && npm run lab:import:ohada:sales && npm run lab:import:ohada:treasury && npm run lab:import:ohada:provisions && npm run lab:import:ohada:core-final",
    "lab:import:ifrs": "node eynowa-lab/professional/import-knowledge.js eynowa-lab/professional/packs/ifrs/core/eynowa-accounting-methodology.json && node eynowa-lab/professional/import-knowledge.js eynowa-lab/professional/packs/ifrs/core/official-public-metadata.json",
    "lab:import:audit": "node eynowa-lab/professional/import-knowledge.js eynowa-lab/professional/packs/audit/core/eynowa-audit-methodology.json && node eynowa-lab/professional/import-knowledge.js eynowa-lab/professional/packs/audit/core/official-public-metadata.json",
    "lab:import:advisory": "node eynowa-lab/professional/import-knowledge.js eynowa-lab/professional/packs/advisory/core/eynowa-advisory-methodology.json && node eynowa-lab/professional/import-knowledge.js eynowa-lab/professional/packs/advisory/core/official-public-metadata.json",
    "lab:import:professional:all": "npm run lab:import:ohada:all && npm run lab:import:ifrs && npm run lab:import:audit && npm run lab:import:advisory"
  },
  "dependencies": { "chromadb": "3.5.0" }
}
