# OFFICE MANAGER SUR LE SERVEUR DU CABINET (VPS) — réglages.
# Copier ce fichier en « .env » sur le serveur, puis remplir. Le fichier .env n'est JAMAIS mis dans Git ni envoyé à quelqu'un.
# Pour un DÉMÉNAGEMENT depuis Vercel : recopier les MÊMES valeurs que dans Vercel → Settings → Environment Variables
# (sinon les accès Google et les clés « Mon IA » déjà enregistrés, chiffrés avec ces clés, ne pourront plus être lus).

# ---- Adresse ----------------------------------------------------------------------------------------------------------
OFFICE_MANAGER_DOMAIN=office.mon-cabinet.com
OFFICE_MANAGER_PUBLIC_URL=https://office.mon-cabinet.com

# ---- Base de données (le serveur PostgreSQL est dans docker-compose) ----------------------------------------------------
# Un mot de passe long et aléatoire (par ex. : openssl rand -base64 32). Ne plus le changer ensuite.
POSTGRES_PASSWORD=

# ---- Cabinet ------------------------------------------------------------------------------------------------------------
# Identifiant du cabinet (le même que DEFAULT_ORG_ID dans Vercel pour un déménagement).
DEFAULT_ORG_ID=
OFFICE_MANAGER_MULTI_CABINET=on
# Adresses autorisées à devenir le premier propriétaire (obligatoire en production).
FIRST_OWNER_EMAILS=

# ---- Secrets (mêmes valeurs que dans Vercel pour un déménagement ; sinon : openssl rand -hex 32) --------------------------
OFFICE_MANAGER_INTERNAL_SECRET=
OFFICE_MANAGER_SCHEDULER_SECRET=
OAUTH_STATE_SECRET=
OWNER_APPROVAL_SECRET=
GOOGLE_TOKEN_ENCRYPTION_KEY=
OFFICE_MANAGER_ACCESS_TOKEN=
OFFICE_MANAGER_OWNER_TOKEN=

# ---- Google (client OAuth du cabinet : Drive, Gmail, « Continuer avec Google ») ------------------------------------------
# Dans Google Cloud → Identifiants → le client OAuth : ajouter l'adresse de retour https://office.mon-cabinet.com/oauth/google/callback
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=

# ---- Envoi des e-mails de confirmation d'adresse (inscription) -----------------------------------------------------------
# Un compte d'envoi (fournisseur e-mail du cabinet, Brevo, Mailjet, Google Workspace…).
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=Office Manager <no-reply@mon-cabinet.com>

# ---- IA (au moins une) ---------------------------------------------------------------------------------------------------
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5
OPENAI_API_KEY=
OPENAI_MODEL=
GEMINI_API_KEY=
OPENROUTER_API_KEY=

# ---- Facultatif ----------------------------------------------------------------------------------------------------------
# OFFICE_MANAGER_AI_DAILY_LIMIT=
# SHADOW_GITHUB_TOKEN=
# OFFICE_MANAGER_ENV=test            (serveur d'essai : désactive les garde-fous de production)
# OFFICE_MANAGER_SCHEDULER=off       (arrête les passages automatiques toutes les 5 minutes)
