+/* Keep the corporate palette local to the shell, including after firm branding loads. */
+.shell{
+  --brand:#142D4E; --on-brand:#FFFFFF; --brand-ink:#142D4E;
+}
+.nav{color:var(--ink);border-right:1px solid var(--nav-line)}
+.nav a:hover,.nav .who .me [data-user-name],
+.nav .avatar,.nav .gear:hover,.nav .gear[aria-expanded="true"],
+.nav .nav-toggle{color:var(--ink)}
+.nav a[aria-current="page"]{color:var(--on-brand)}
+.page-head h1,.card h2,.workspace-heading{color:var(--ink)}
+
